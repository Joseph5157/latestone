.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
*.egg-info/
.DS_Store
*.zip

# Agent/tooling scratch — never part of the application
.claude/*
!.claude/skills/
.playwright-mcp/
.serena/
.superpowers/
scratch/

# .claude/skills/ is the one exception above: process instructions, same
# class as AGENTS.md — tracked for history/review, excluded from
# client-release via scripts/check_client_release.py rather than hidden from
# git entirely. .claude/worktrees/ and .claude/settings.local.json are
# genuinely machine-local (literal filesystem checkouts, local permission
# grants) and stay ignored by the .claude/* rule above.

# Generated context pack (scripts/build_context_pack.py) — regenerate, never
# commit; a stale copy checked in would be exactly the staleness this exists
# to prevent. docs/context/CURRENT_STATE.md is also generated but IS tracked,
# deliberately, so its git history shows how the baseline moved over time.
.agent-context/

# Internal engineering docs — not for client distribution
CLAUDE.md
IMPLEMENTATION_PLAN.md
docs/superpowers/
docs/CODE_AUDIT.md
docs/CODE_AUDIT_SECOND_PASS.md
docs/UX_DEBT.md
docs/CLIENT_DELIVERY.md
docs/DEMO_RUNSHEET.md

# Browser-review screenshots (working artefacts of a UI pass, not app assets)
ent*-*.png

# Alternative-agent tooling config
opencode.json

# Internal planning prompts / roadmap — not for client distribution.
# Tracked in git (history + PR review), excluded from client-release via
# scripts/check_client_release.py instead of hidden from git entirely.
Power_RTL_Enterprise_UX_Execution_Roadmap.md
docs/Professional_Workflow*.pdf
.freshness-demo-capture.json
