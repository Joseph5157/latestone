# PostgreSQL connection (local Docker instance)
POSTGRES_DB=powerplant_demo
POSTGRES_USER=powerplant
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Schema
DB_SCHEMA=trfr_temperature

# Demo warning threshold (Celsius) - NOT an official client threshold
