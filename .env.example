# PostgreSQL connection (local Docker instance)
POSTGRES_DB=powerplant_demo
POSTGRES_USER=powerplant
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Isolated stack so this checkout does not collide with any other local
# PostgreSQL container. Both values are required for the canonical
# development environment.
COMPOSE_PROJECT_NAME=plant-monitoring-arch
POSTGRES_CONTAINER_NAME=plant_monitoring_postgres

# Schemas
PLANT_MONITORING_SCHEMA=plant_monitoring

# Freshness policy
# 30-minute cadence = project/client-known requirement.
# 3 missed intervals = DEVELOPMENT policy, needs client confirmation.
EXPECTED_INTERVAL_MINUTES=30
STALE_AFTER_INTERVALS=3

# UI refresh cadence (seconds) - short for local dev convenience
UI_REFRESH_INTERVAL_SECONDS=60

# Demo auth (local/mock only - not production)
DEMO_USERNAME=admin
DEMO_PASSWORD=demo1234

# Dash
DASH_DEBUG=true
DASH_HOST=0.0.0.0
DASH_PORT=8050

# Live simulator (db/live_simulator.py) - optional demo/dev "live feed" that
# appends new readings on a timer while the app runs. Not needed to run the
# app itself; see the module docstring. All optional, shown here at their
# defaults (empty = every device / every metric):
# LIVE_SIM_INTERVAL_SECONDS=10
# LIVE_SIM_DEVICE_IDS=
# LIVE_SIM_METRICS=
# LIVE_SIM_NOISE_SCALE=1.0
