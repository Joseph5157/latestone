# PostgreSQL connection (local Docker instance)
POSTGRES_DB=powerplant_demo
POSTGRES_USER=powerplant
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional. Set both only when running a second, isolated stack (e.g. a git
# worktree) alongside an existing one, to avoid container-name/port collisions.
# COMPOSE_PROJECT_NAME=plant-monitoring-arch
# POSTGRES_CONTAINER_NAME=plant_monitoring_postgres

# Schemas
PLANT_MONITORING_SCHEMA=plant_monitoring

# Freshness policy
# 30-minute cadence = project/client-known requirement.
# 3 missed intervals = DEVELOPMENT policy, needs client confirmation.
EXPECTED_INTERVAL_MINUTES=30
STALE_AFTER_INTERVALS=3

# UI refresh cadence (seconds) - short for local dev convenience
UI_REFRESH_INTERVAL_SECONDS=60

# Demo auth (local/mock only - not production)
DEMO_USERNAME=admin
DEMO_PASSWORD=demo1234

# Dash
DASH_DEBUG=true
DASH_HOST=0.0.0.0
DASH_PORT=8050
