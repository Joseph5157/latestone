# PostgreSQL connection (local Docker instance)
POSTGRES_DB=powerplant_demo
POSTGRES_USER=powerplant
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Isolated stack so this checkout does not collide with any other local
# PostgreSQL container. Both values are required for the canonical
# development environment.
COMPOSE_PROJECT_NAME=plant-monitoring-arch
POSTGRES_CONTAINER_NAME=plant_monitoring_postgres

# Schemas
PLANT_MONITORING_SCHEMA=plant_monitoring

# Freshness policy
# 30-minute cadence = project/client-known requirement.
# 3 missed intervals = DEVELOPMENT policy, needs client confirmation.
EXPECTED_INTERVAL_MINUTES=30
STALE_AFTER_INTERVALS=3

# UI refresh cadence (seconds) - short for local dev convenience
UI_REFRESH_INTERVAL_SECONDS=60

# Demo auth (local/mock only - not production)
# DEMO_USERNAME/DEMO_PASSWORD is the administrator login. There is no fallback:
# unset means every login is refused.
DEMO_USERNAME=admin
DEMO_PASSWORD=demo1234

# Additional demo logins, as a JSON object of "username": "password" (ROLE-4A).
# JSON rather than a delimiter-separated list so a password can contain any
# character -- commas and colons included -- with exactly one reading. A
# malformed, non-string or repeated entry refuses the WHOLE map (every login,
# including the administrator above) rather than leaving some working.
#
# THESE NAME LOGINS, NOT ROLES. The username must already exist in
# plant_monitoring.users, and that row decides the role; nothing here can grant
# one. Seed the identities first:
#     python -m db.seed_admin_demo      # demo.tech01..05  (technician)
#     python -m db.seed_demo_personas   # demo.general01   (general)
# Replace these placeholder secrets locally; never commit real ones.
DEMO_CREDENTIALS={"demo.tech01": "tech1234", "demo.general01": "general1234"}

# Environment / deployment mode (AUTH-PROD-HARDEN-1). The one setting that
# decides whether FLASK_SECRET_KEY below is optional or required, and whether
# the session cookie is marked Secure. Unset (or any value other than
# "production") means "development" -- today's easy local setup, unchanged.
# Set APP_ENV=production only for a real deployment (e.g. Railway).
# APP_ENV=development

# Server-trusted session (AUTH-HARDEN-1). Signs the Flask session cookie that
# services.auth_service uses to identify the logged-in user -- distinct from
# and more trustworthy than DEMO_CREDENTIALS above and the browser-side
# auth-store dcc.Store, neither of which is trusted for authorization.
#
# OPTIONAL for local/demo use (APP_ENV unset or "development"): unset falls
# back to a fresh random key generated once per process start, which is a
# STRONGER default than any fixed value published here would be -- the
# tradeoff is that a server restart invalidates every open session (log in
# again), same as a browser tab close already does today.
#
# REQUIRED when APP_ENV=production: startup fails closed (raises, does not
# start) if this is missing or blank. A production deployment must never
# silently sign with a per-process random key -- that would invalidate every
# open session on each restart/redeploy and let replicas disagree.
# FLASK_SECRET_KEY=

# Dash
DASH_DEBUG=true
DASH_HOST=0.0.0.0
DASH_PORT=8050

# RTL programming simulator (RTL-PROG-SIM-1) - development/demo ONLY.
# When enabled, the Program RTL drawer gains a clearly-labelled simulation
# section that runs a recorded programming request through the deterministic
# SimulatorTransport (ADR-018) so a local/demo operator can watch the request
# progress queued -> sent -> successful/failed end to end.
#
# NO physical RTL, MQTT, SMS or Eskom communication occurs. A simulated
# "successful" is NOT evidence that any device was programmed.
#
# Default is OFF: unset, blank, or any non-truthy value keeps the simulator
# unreachable, and the simulation controls do not render at all.
# Enabling this together with APP_ENV=production FAILS CLOSED at startup
# (raises, does not start) rather than silently enabling or silently
# ignoring the request.
# RTL_PROGRAMMING_SIMULATOR_ENABLED=true

# Live simulator (db/live_simulator.py) - optional demo/dev "live feed" that
# appends new readings on a timer while the app runs. Not needed to run the
# app itself; see the module docstring. All optional, shown here at their
# defaults (empty = every device / every metric):
# LIVE_SIM_INTERVAL_SECONDS=10
# LIVE_SIM_DEVICE_IDS=
# LIVE_SIM_METRICS=
# LIVE_SIM_NOISE_SCALE=1.0
